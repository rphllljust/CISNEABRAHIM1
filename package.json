{
  "name": "cisne-rondonia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils@3.3.2>esbuild": "0.25.12",
      "@nestjs/platform-fastify@11.2.3>fastify": "5.12.1"
    }
  },
  "scripts": {
    "install:deps": "pnpm install",
    "lint": "node scripts/check-scripts.mjs && node scripts/check-source-size-budget.mjs && turbo run lint",
    "gate:scripts": "node scripts/check-scripts.mjs",
    "gate:scripts:self-test": "node scripts/check-scripts.mjs --self-test",
    "format": "prettier --write \"apps/**\" \"packages/**\" \"docs/17-bootstrap/**\" \"docs/18-database-foundation/**\" \"*.{json,mjs,md}\"",
    "format:check": "prettier --check \"apps/**\" \"packages/**\" \"docs/17-bootstrap/**\" \"docs/18-database-foundation/**\" \"*.{json,mjs,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "test:perf:smoke": "pnpm --filter @cisne/api test:perf:smoke",
    "test:perf": "pnpm --filter @cisne/api test:perf",
    "backup:run": "pnpm --filter @cisne/api backup:run",
    "dr:drill": "pnpm --filter @cisne/api dr:drill",
    "hml:up": "docker compose -f docker/hml/compose.yaml --env-file .env.hml up -d --build --wait",
    "hml:down": "docker compose -f docker/hml/compose.yaml --env-file .env.hml down",
    "hml:deploy": "node scripts/hml/deploy.mjs",
    "hml:smoke": "pnpm --filter @cisne/api hml:smoke",
    "cd:promote": "node scripts/cd/promote.mjs",
    "cd:manifest": "node scripts/cd/emit-deploy-manifest.mjs",
    "prod:validate": "node scripts/prod/validate.mjs",
    "test:uat": "pnpm --filter @cisne/api test:uat",
    "pilot:status": "node scripts/pilot/status.mjs",
    "release:drill": "node scripts/release/drill.mjs",
    "release:package": "node scripts/release/package.mjs",
    "readiness:gate": "node scripts/readiness/gate.mjs",
    "readiness:engineering": "node scripts/readiness/engineering.mjs",
    "readiness:record-milestones": "node scripts/readiness/record-milestones.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "db:up": "docker compose -f docker/compose.yaml up -d --wait",
    "db:down": "docker compose -f docker/compose.yaml down",
    "db:reset": "docker compose -f docker/compose.yaml down -v && docker compose -f docker/compose.yaml up -d --wait && node scripts/wait-for-postgres.mjs && pnpm db:migrate",
    "db:wait": "node scripts/wait-for-postgres.mjs",
    "db:migrate": "pnpm db:migrate:dev && pnpm db:migrate:test",
    "db:migrate:dev": "pnpm --filter @cisne/database migrate",
    "db:migrate:test": "node scripts/migrate-test-database.mjs",
    "db:repair:test-journal": "node scripts/sync-drizzle-journal.mjs",
    "db:generate": "pnpm --filter @cisne/database generate",
    "db:seed:dev": "pnpm --filter @cisne/database seed:dev",
    "auth:repair:dev-login": "node scripts/repair-dev-login.mjs",
    "bootstrap:own-company": "pnpm --filter @cisne/api bootstrap:own-company",
    "db:seed:synthetic": "pnpm --filter @cisne/api seed:synthetic",
    "db:seed:demo-ui": "pnpm db:seed:synthetic",
    "db:seed:portfolio": "pnpm --filter @cisne/database seed:portfolio",
    "bootstrap:first-identity": "pnpm --filter @cisne/database bootstrap:production",
    "validate:fullstack": "node scripts/fullstack-data-validation.mjs",
    "gate:database": "pnpm --filter @cisne/database gate:ci-database",
    "gate:src-002": "node scripts/validate-src-002-gate.mjs",
    "test:migration-torture": "pnpm --filter @cisne/database test:migration-torture",
    "test:chaos-recovery": "pnpm --filter @cisne/api test:chaos-recovery",
    "test:frontend-resilience": "pnpm --filter @cisne/web test:frontend-resilience",
    "test:performance-stress": "pnpm --filter @cisne/api test:performance-stress",
    "audit:deps": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@cisne/eslint-config": "workspace:*",
    "@cisne/tsconfig": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
