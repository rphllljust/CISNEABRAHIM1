# Runtime-only Railway image for an already validated CISNE release.
# No Vite/source build is allowed in promotion.
FROM nginx:1.27-alpine
ENV NGINX_ENVSUBST_OUTPUT_DIR=/usr/share/nginx/html
COPY docker/railway/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/release/runtime-config.js.template /etc/nginx/templates/runtime-config.js.template
COPY apps/web/dist /usr/share/nginx/html
COPY artifacts/release-identity.json /usr/share/nginx/html/release-identity.json
EXPOSE 80
