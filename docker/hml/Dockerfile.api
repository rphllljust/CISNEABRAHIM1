# CISNE API/worker — hermetic production-like image.
# Builder: full workspace install + canonical build (network needed only here).
# Runner: production-only dependencies installed from the lockfile over the
# whitelisted workspace manifests; then dist + migrations are copied in.
# Final image: no devDependencies, no source tree, no source maps, no .env.

FROM node:24-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.34.7 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
# Database dist must exist before the API compiles against @cisne/database.
RUN pnpm --filter @cisne/database build && pnpm --filter @cisne/api build
RUN find /app/apps/api/dist /app/packages/database/dist -name '*.map' -delete

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@10.34.7 --activate
# Workspace manifests only (no sources): pnpm install --prod resolves every
# runtime require from the lockfile and links @cisne/database to the real dir.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/database/package.json ./packages/database/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/tsconfig/package.json ./packages/tsconfig/
RUN pnpm install --prod --frozen-lockfile

COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/packages/database/dist ./packages/database/dist
# Bundled migrations (journal + SQL) for the hermetic migrate runner
# (packages/database/dist/cli/run-migrate-cli.js resolves ../.. -> /app/packages/database/migrations).
COPY --from=builder /app/packages/database/migrations ./packages/database/migrations

EXPOSE 3000
CMD ["sh", "-c", "node apps/api/dist/ops/prod/cli/ensure-production-credentials.js && node apps/api/dist/main.js"]
