# CISNE Rondônia — Produção (referência endurecida)
# Copiar para .env.prod (nunca commitar). Secrets devem ser montados por secret
# manager / Docker secrets e referenciados por *_FILE; não colocar material
# sensível diretamente neste arquivo.

CISNE_ENV=production
NODE_ENV=production

# URLs públicas (HTTPS obrigatório)
PROD_PUBLIC_API_URL=https://api.cisne.example
PROD_PUBLIC_WEB_URL=https://app.cisne.example
PUBLIC_API_URL=https://api.cisne.example
PUBLIC_WEB_URL=https://app.cisne.example
CORS_ORIGIN=https://app.cisne.example
PORT=3000
API_HOST=0.0.0.0

# Edge — somente 80/443 expostos via Caddy
PROD_EXPOSED_PORTS=80,443
PROD_DOMAIN=api.cisne.example
PROD_WEB_DOMAIN=app.cisne.example

# PostgreSQL — storage durável em rede interna privada (compose de referência)
PROD_POSTGRES_USER=cisne_prod
PROD_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
PROD_POSTGRES_DB=cisne_production
DATABASE_URL_FILE=/run/secrets/database_url
PGSSLMODE=disable
DATABASE_POOL_MAX=10
PROD_POSTGRES_STORAGE_GB=20
PROD_REQUIRE_DB_TLS=false

# Object storage — privado, versionado, lifecycle gerenciado.
# No compose MinIO de referência, use credenciais montadas. Em cloud com IAM
# role/workload identity, defina OBJECT_STORAGE_IAM_ROLE=true e omita as chaves.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=cisne-prod-documents
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_VERSIONING=true
OBJECT_STORAGE_LIFECYCLE_CONFIGURED=true
OBJECT_STORAGE_IAM_ROLE=false
S3_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key_id
S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key

# Secrets — fail-closed: runtime precisa resolver arquivos montados.
PROD_REQUIRE_SECRET_STORE=true
JWT_SECRET_FILE=/run/secrets/jwt_secret
DOCUMENT_DOWNLOAD_TOKEN_SECRET_FILE=/run/secrets/document_download_token_secret
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key

# Service accounts / IAM
BACKUP_USE_DEDICATED_ROLE=true
PROD_CLOUD_ADMIN_CREDENTIALS=false

# Scaling baseline. Enquanto o limiter for em memória, produção é single replica.
# Para >1 réplica, configure um limiter compartilhado no edge e marque backend=external.
PROD_API_REPLICAS=1
SECURITY_RATE_LIMIT_BACKEND=memory

# Cost controls
PROD_COST_ALERTS_ENABLED=true
PROD_MONTHLY_BUDGET_USD=500

# Backup — ambos os artefatos são obrigatórios quando habilitados.
BACKUP_ENABLE_POSTGRES=true
BACKUP_ENABLE_OBJECT_STORAGE=true
BACKUP_STATUS_FILE=.backup/prod/status/latest.json

# TLS
PROD_REQUIRE_TLS=true

# Outbox worker (multi-instance safe via DB locking)
OUTBOX_PUBLISHER_ENABLED=true

# Integrações — configurar sandbox/produção conforme política empresarial
EMAIL_NOTIFICATION_CONFIGURED=false
WHATSAPP_NOTIFICATION_CONFIGURED=false
