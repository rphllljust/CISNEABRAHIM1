{
  "name": "@cisne/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./test-builders": {
      "types": "./dist/test-builders/index.d.ts",
      "default": "./dist/test-builders/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.spec.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed:dev": "tsc -p tsconfig.json && node scripts/seed-dev.mjs",
    "seed:profiles": "tsc -p tsconfig.json && node scripts/seed-profiles.mjs",
    "migrate:release": "node dist/cli/run-migrate-cli.js",
    "bootstrap:production": "node dist/cli/run-bootstrap-cli.js",
    "gate:ci-database": "node scripts/ci-database-gate.mjs",
    "test:migration-torture": "vitest run --config vitest.integration.config.ts src/migration-torture.integration.spec.ts"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@cisne/eslint-config": "workspace:*",
    "@cisne/tsconfig": "workspace:*",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
