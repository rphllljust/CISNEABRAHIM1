# Ambiente — copiar para .env (nunca commitar .env)
NODE_ENV=development

# API (apps/api)
PORT=3000
API_HOST=0.0.0.0

# Web (apps/web) — dev server
VITE_API_BASE_URL=http://localhost:3000

# PostgreSQL local (docker/compose.yaml) — credenciais DEV ONLY
POSTGRES_USER=cisne_local_dev
POSTGRES_PASSWORD=cisne_local_dev_password_change_me
POSTGRES_DB=cisne_local_dev
CISNE_TEST_DB=cisne_local_test

# Conexão aplicacional (pool via @cisne/database)
DATABASE_URL=postgresql://cisne_local_dev:cisne_local_dev_password_change_me@127.0.0.1:5432/cisne_local_dev
TEST_DATABASE_URL=postgresql://cisne_local_dev:cisne_local_dev_password_change_me@127.0.0.1:5432/cisne_local_test

# Pool (opcional)
DATABASE_POOL_MAX=10

# DEVELOPMENT_SEED (NODE_ENV=development apenas) — senha via variável local, nunca no código
# DEV_SEED_PASSWORD=

# PERFIS ESTÁTICOS DE DESENVOLVIMENTO/HOMOLOGAÇÃO — os valores saem do repositório.
# Sem estas variáveis, `packages/database/scripts/seed-profiles.mjs` e
# `scripts/repair-dev-login.mjs` FALHAM ALTO (não existe default silencioso).
# DEV_PROFILE_OWNER_PASSWORD=
# DEV_PROFILE_MONICA_PASSWORD=
# DEV_PROFILE_FINANCE_PASSWORD=
# DEV_PROFILE_DEVELOPER_PASSWORD=
# DEV_PROFILE_EMPLOYEE_PASSWORD=

# SYNTHETIC_BUSINESS_SEED (development / homologation only — never production)
# DEVELOPMENT_SYNTHETIC_SEED_CONFIRM=I_UNDERSTAND
# SEED_REFERENCE_DATE=2026-08-01T12:00:00-04:00
# SYNTHETIC_SEED_UNIT_ID=unit-synthetic-homolog

# PRODUCTION_BOOTSTRAP (execução manual explícita; nunca no startup)
# BOOTSTRAP_ADMIN_LOGIN=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_CONFIRM=I_UNDERSTAND

# Autenticação (apps/api) — JWT_SECRET obrigatório em runtime (≥32 caracteres; nunca commitar valor real)
# JWT_SECRET=
JWT_ISSUER=cisne-api
JWT_AUDIENCE=cisne-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=43200
# Aceita lista separada por vírgula (ex.: porta alternativa do Vite em LAN)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=5
JWT_CLOCK_SKEW_SECONDS=30

# Object storage (apps/api/documents) — S3-compatible; storage keys nunca expostos em DTO
# Relative paths resolve under CISNE_RUNTIME_DIR (default: <repo>/.runtime), not the source tree.
CISNE_RUNTIME_DIR=.runtime
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_ROOT=object-storage
OBJECT_STORAGE_BUCKET=cisne-documents
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=600
# OBJECT_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# OBJECT_STORAGE_S3_REGION=us-east-1
# OBJECT_STORAGE_S3_ACCESS_KEY_ID=
# OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_S3_FORCE_PATH_STYLE=true
# DOCUMENT_DOWNLOAD_TOKEN_SECRET=

# Backup (Prompt 84) — credencial separada; nunca commitar chave real
# BACKUP_DEST_DIR=.backup/artifacts
# BACKUP_OFFSITE_DIR=
# BACKUP_STATUS_FILE=.backup/status/latest.json
# BACKUP_ENCRYPTION_KEY=   # 32 bytes base64 (openssl rand -base64 32)
# BACKUP_POSTGRES_MODE=pg_dump   # pg_dump | docker
# BACKUP_POSTGRES_DOCKER_CONTAINER=cisne_local_postgres
# BACKUP_ENABLE_POSTGRES=true
# BACKUP_ENABLE_OBJECT_STORAGE=true
# BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY=4
# TECH_BACKUP_LAST_STATUS=ok
# TECH_BACKUP_LAST_CHECKED_AT=
# TECH_BACKUP_LAST_DURATION_MS=
# TECH_BACKUP_LAST_SIZE_BYTES=
# TECH_BACKUP_LAST_ARTIFACT_COUNT=

# Disaster recovery drill (Prompt 85) — ambiente isolado obrigatório
# DR_ISOLATED_ROOT=.backup/dr-drill
# DR_STATUS_FILE=.backup/dr-drill/status/latest.json
# DR_DATABASE_URL=          # sandbox dedicado; nunca produção
# DR_OBJECT_STORAGE_ROOT=   # cópia isolada do object storage
# DR_OBJECT_STORAGE_SOURCE= # storage canônico para hidratar objetos do DB antes do backup DR
# DR_SCENARIO=bad_deployment
# DR_ALLOW_PRODUCTION=      # nunca em prod real sem processo formal
# DR_CLEANUP_ISOLATED=true  # remove artefatos do drill ao final

# ---------------------------------------------------------------------------------------------
# Superfície de módulos — DUAS famílias de variáveis, uma por camada
# ---------------------------------------------------------------------------------------------
# A API lê `FEATURE_MODULE_*` (sem prefixo) em RUNTIME, por `process.env`
# (`apps/api/src/platform/release-scope/release-1-scope.ts`).
# O web lê `VITE_FEATURE_MODULE_*` em BUILD, por `import.meta.env`
# (`apps/web/src/release-scope/feature-flags.ts`).
#
# As duas famílias são independentes: nada as acopla automaticamente. Declarar só uma
# produz superfície incoerente — o menu mostra o que o servidor recusa (403 FEATURE_DISABLED,
# fail-closed) ou o inverso. Ao ligar um módulo, ligue NAS DUAS.
#
# Fail-closed: ausente ou diferente da string exata 'true' = desligado.

# API (runtime) — módulos fora do escopo fechado da Release 1
# FEATURE_MODULE_FINANCE=true
# FEATURE_MODULE_FISCAL=true
# FEATURE_MODULE_ACCOUNTING=true
# FEATURE_MODULE_INVENTORY=true
# FEATURE_MODULE_PAYROLL=true
# FEATURE_MODULE_PROCUREMENT=true
# FEATURE_MODULE_SUPPLIERS=true
# FEATURE_MODULE_CONTRACTS=true
# FEATURE_MODULE_PEOPLE=true
# FEATURE_MODULE_ALERTS=true
# FEATURE_MODULE_REPORTS=true
# FEATURE_MODULE_APPROVAL_MATRIX=true
# FEATURE_MODULE_OPERATIONAL_PROFITABILITY=true
# Stubs comprovados (STUB_MODULES): permanecem desligados, não ligue por conveniência.
FEATURE_MODULE_RENTALS=false
FEATURE_MODULE_TRANSPORT=false

# Web (build) — superfície do artefato
# VITE_CISNE_SURFACE=dev
# VITE_FEATURE_MODULE_FINANCE=true
# VITE_FEATURE_MODULE_FISCAL=true
# VITE_FEATURE_MODULE_ACCOUNTING=true
# VITE_FEATURE_MODULE_INVENTORY=true
# VITE_FEATURE_MODULE_PAYROLL=true
# VITE_FEATURE_MODULE_PROCUREMENT=true
# VITE_FEATURE_MODULE_SUPPLIERS=true
# VITE_FEATURE_MODULE_CONTRACTS=true
# VITE_FEATURE_MODULE_PEOPLE=true
# VITE_FEATURE_MODULE_ALERTS=true
# VITE_FEATURE_MODULE_REPORTS=true
# VITE_FEATURE_MODULE_APPROVAL_MATRIX=true
# VITE_FEATURE_MODULE_OPERATIONAL_PROFITABILITY=true
VITE_FEATURE_MODULE_RENTALS=false
VITE_FEATURE_MODULE_TRANSPORT=false
