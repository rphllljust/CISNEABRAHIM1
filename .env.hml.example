# Homologação (HML) — copiar para .env.hml (nunca commitar .env.hml)
# Monorepo: use estes defaults (contexto de build = raiz do repositório).
# Repositórios separados: use .env.hml.example em cisne-infra.
# Dados sintéticos apenas. Nunca compartilhar DB/storage/secrets com produção.

# Build (monorepo — omitir ou deixar comentado)
# CISNE_BACKEND_DIR=../..
# CISNE_FRONTEND_DIR=../..
# CISNE_API_DOCKERFILE=docker/hml/Dockerfile.api
# CISNE_WEB_DOCKERFILE=docker/hml/Dockerfile.web

CISNE_ENV=hml
NODE_ENV=production

# URLs públicas HML
HML_PUBLIC_API_URL=http://127.0.0.1:3100
HML_PUBLIC_WEB_URL=http://127.0.0.1:5174
PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://127.0.0.1:5174

# PostgreSQL HML dedicado
HML_POSTGRES_USER=cisne_hml
HML_POSTGRES_PASSWORD=cisne_hml_password_change_me
HML_POSTGRES_DB=cisne_hml
DATABASE_URL=postgresql://cisne_hml:cisne_hml_password_change_me@127.0.0.1:5433/cisne_hml
DATABASE_POOL_MAX=10

# Object storage HML (filesystem dedicado — S3 adapter ainda não promovido)
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_ROOT=.object-storage-hml
OBJECT_STORAGE_BUCKET=cisne-hml-documents

# Secrets HML (gerar valores únicos; nunca reutilizar produção)
JWT_SECRET=hml-jwt-secret-with-at-least-32-characters-change-me
JWT_ISSUER=cisne-api-hml
JWT_AUDIENCE=cisne-clients-hml
DOCUMENT_DOWNLOAD_TOKEN_SECRET=hml-document-token-secret-change-me

# Integrações — sandbox only; outbound real desabilitado
HML_INTEGRATIONS_SANDBOX=true
EMAIL_NOTIFICATION_CONFIGURED=false
EMAIL_NOTIFICATION_ENABLED=false
WHATSAPP_NOTIFICATION_CONFIGURED=false
WHATSAPP_NOTIFICATION_ENABLED=false

# Bootstrap sintético (sem PII de produção)
HML_BOOTSTRAP_SYNTHETIC=true
HML_SYNTHETIC_SEED_CONFIRM=I_UNDERSTAND
BOOTSTRAP_ADMIN_LOGIN=hml-admin@cisne.invalid
BOOTSTRAP_ADMIN_PASSWORD=Synthetic-HML-Only-Password-123!
BOOTSTRAP_CONFIRM=I_UNDERSTAND
HML_SMOKE_LOGIN=hml-admin@cisne.invalid
HML_SMOKE_PASSWORD=Synthetic-HML-Only-Password-123!

# Observabilidade
BACKUP_STATUS_FILE=.backup/hml/status/latest.json

# ---------------------------------------------------------------------------------------------
# Superfície de módulos — API (lida em RUNTIME por apps/api)
# ---------------------------------------------------------------------------------------------
# A API lê `FEATURE_MODULE_*` SEM prefixo VITE_ (`apps/api/src/platform/release-scope/
# release-1-scope.ts`). O serviço `api` do compose recebe estas chaves por `env_file`.
# O guard é fail-closed e compara com a string exata 'true': ausente = módulo desligado = 403.
#
# Sem este bloco, um .env.hml derivado deste example deixava a API sem NENHUMA flag,
# enquanto o web era buildado com os módulos ligados — o menu aparecia e cada chamada
# respondia 403 FEATURE_DISABLED. Os dois blocos precisam concordar.
FEATURE_MODULE_FINANCE=true
FEATURE_MODULE_FISCAL=true
FEATURE_MODULE_ACCOUNTING=true
FEATURE_MODULE_INVENTORY=true
FEATURE_MODULE_PAYROLL=true
FEATURE_MODULE_PROCUREMENT=true
FEATURE_MODULE_SUPPLIERS=true
FEATURE_MODULE_CONTRACTS=true
FEATURE_MODULE_PEOPLE=true
FEATURE_MODULE_ALERTS=true
FEATURE_MODULE_REPORTS=true
FEATURE_MODULE_APPROVAL_MATRIX=true
FEATURE_MODULE_OPERATIONAL_PROFITABILITY=true

# Stubs sem backend real — desligados (STUB_MODULES).
FEATURE_MODULE_RENTALS=false
FEATURE_MODULE_TRANSPORT=false

# ---------------------------------------------------------------------------------------------
# Superfície de módulos do artefato web (build-time ARGS do docker/hml/Dockerfile.web)
# ---------------------------------------------------------------------------------------------
# HML homologa o produto CONSTRUÍDO. Estes valores espelham a política de
# `apps/web/src/release-scope/feature-flags.ts`; a variável explícita por módulo vence o
# default da superfície. Sem estas chaves o build cai no default do Dockerfile — que antes era
# `false` para módulos já construídos e produzia, em silêncio, um HML mutilado.
#
# IMPORTANTE: a flag NÃO é controle de acesso. A fronteira de segurança é o backend
# (AuthorizationGuard + PDP fail-closed). Ligar um módulo aqui apenas publica a superfície;
# quem pode ler e escrever continua sendo decidido por identidade e escopo no servidor.
VITE_CISNE_SURFACE=hml

# Módulos construídos — ligados em HML.
VITE_FEATURE_MODULE_FINANCE=true
VITE_FEATURE_MODULE_FISCAL=true
VITE_FEATURE_MODULE_ACCOUNTING=true
VITE_FEATURE_MODULE_INVENTORY=true
VITE_FEATURE_MODULE_PAYROLL=true
VITE_FEATURE_MODULE_PROCUREMENT=true
VITE_FEATURE_MODULE_SUPPLIERS=true
VITE_FEATURE_MODULE_CONTRACTS=true
VITE_FEATURE_MODULE_PEOPLE=true
VITE_FEATURE_MODULE_ALERTS=true
VITE_FEATURE_MODULE_REPORTS=true
VITE_FEATURE_MODULE_APPROVAL_MATRIX=true
VITE_FEATURE_MODULE_OPERATIONAL_PROFITABILITY=true

# Stubs sem backend real (rentals/transport têm *-api.ts de 8 linhas): permanecem desligados.
VITE_FEATURE_MODULE_RENTALS=false
VITE_FEATURE_MODULE_TRANSPORT=false

# Deploy
# HML_SKIP_SMOKE=false
